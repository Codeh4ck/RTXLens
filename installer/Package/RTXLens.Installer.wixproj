<Project Sdk="WixToolset.Sdk/7.0.0">
    <PropertyGroup>
        <OutputName>RTXLens-$(InstallerVersion)-win-x64</OutputName>
        <OutputPath>bin/x64/$(Configuration)/</OutputPath>
        <!-- WinUI's signed multilingual DLLs contain long language lists and modern LCIDs unknown to ICE03.
             The installer tests validate this exception against the actual payload; all other ICEs remain enabled. -->
        <SuppressIces>ICE03</SuppressIces>
        <DefineConstants>$(DefineConstants);InstallerVersion=$(InstallerVersion);PayloadDirectory=$(PayloadDirectory)</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="WixToolset.UI.wixext" />
        <PackageReference Include="WixToolset.Util.wixext" />
        <ProjectReference Include="../Actions/RTXLens.Installer.Actions.csproj" />
    </ItemGroup>
    <Target Name="RequirePublishedPayload" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(PayloadDirectory)/Service/RTXLens.Service.exe')" Text="Publish the installer payload with scripts/Build-Release.ps1 before building the MSI." />
        <ItemGroup>
            <RequiredDesktopFile Include="RTXLens.App.exe;RTXLens.App.dll;RTXLens.App.deps.json;RTXLens.App.runtimeconfig.json" />
            <RequiredDesktopFile Include="Avalonia.Desktop.dll;Avalonia.Win32.dll;coreclr.dll" />
        </ItemGroup>
        <Error Condition="!Exists('$(PayloadDirectory)/Desktop/%(RequiredDesktopFile.Identity)')"
               Text="The Avalonia desktop publish payload is missing %(RequiredDesktopFile.Identity). Publish the desktop app using the Portable profile." />
    </Target>
</Project>
