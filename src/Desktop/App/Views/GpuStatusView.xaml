<UserControl
    x:Class="RTXLens.App.Views.GpuStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RTXLens.App.Controls"
    xmlns:converters="using:RTXLens.App.Converters"
    xmlns:telemetry="using:RTXLens.Presentation.Telemetry">
    <UserControl.Resources>
        <converters:BooleanVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="DiagnosticReading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MonitorAccent}" />
        </Style>
        <DataTemplate x:Key="CompactMetric" x:DataType="telemetry:MetricViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinHeight="30">
                <controls:WidgetIcon IconName="{x:Bind IconName}" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Value, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" MaxWidth="225" VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind Value, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="GpuReadingCaption" TargetType="TextBlock" BasedOn="{StaticResource MonitorCaption}">
            <Setter Property="Foreground" Value="{ThemeResource MonitorForeground}" />
        </Style>
        <Style x:Key="GpuReadingCard" TargetType="Border" BasedOn="{StaticResource MonitorCard}">
            <Setter Property="Background" Value="{ThemeResource MonitorInset}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
        <Style x:Key="GpuReadingDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource MonitorBorder}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <DataTemplate x:Key="GpuReading" x:DataType="telemetry:MetricViewModel">
            <StackPanel Spacing="3" Padding="5,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource GpuReadingCaption}" FontSize="14" />
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource MonitorDanger}" VerticalAlignment="Center"
                        Visibility="{x:Bind IsWarning, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                        AutomationProperties.Name="Temperature warning active" ToolTipService.ToolTip="Temperature warning active" />
                </StackPanel>
                <TextBlock controls:MetricText.Value="{x:Bind Value, Mode=OneWay}" Style="{StaticResource DiagnosticReading}"
                    controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" FontSize="18"
                    TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TrafficReading" x:DataType="telemetry:MetricViewModel">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:WidgetIcon IconName="{x:Bind IconName}" Width="20" Height="20" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource GpuReadingCaption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock controls:MetricText.Value="{x:Bind Value, Mode=OneWay}" Style="{StaticResource DiagnosticReading}"
                    controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="14">
        <Grid x:Name="ElectricalSummary" x:Load="{x:Bind ShowSummary}" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:WidgetIcon IconName="pin" Width="20" Height="20" />
                        <TextBlock Text="CONNECTOR POWER" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock controls:MetricText.Value="{x:Bind Model.PowerText, Mode=OneWay}"
                        controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" Foreground="{ThemeResource MonitorForeground}"
                        FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:WidgetIcon IconName="overcurrent" Width="20" Height="20" />
                        <TextBlock Text="TOTAL CURRENT" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock controls:MetricText.Value="{x:Bind Model.CurrentText, Mode=OneWay}"
                        controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" Foreground="{ThemeResource MonitorForeground}"
                        FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:WidgetIcon IconName="voltage" Width="20" Height="20" />
                        <TextBlock Text="VOLTAGE" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock controls:MetricText.Value="{x:Bind Model.VoltageText, Mode=OneWay}"
                        controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" Foreground="{ThemeResource MonitorForeground}"
                        FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="StatusColumns">
            <Border x:Name="StatusFrame" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:WidgetIcon IconName="vcore" Width="28" Height="28" />
                            <TextBlock Text="GPU status" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Model.DeviceText, Mode=OneWay}" Style="{StaticResource MonitorCaption}" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Model.IsUnavailable, Mode=OneWay}" IsClosable="False" Severity="Warning"
                        Title="GPU status unavailable" Message="{x:Bind Model.State, Mode=OneWay}" />
                    <StackPanel Spacing="8">
                        <Border Style="{StaticResource GpuReadingCard}" Padding="12,8" MinHeight="44">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <controls:WidgetIcon IconName="boost-limit" Width="24" Height="24" />
                                    <TextBlock Text="GPU usage" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" Style="{StaticResource DiagnosticReading}"
                                    controls:MetricText.Value="{x:Bind Model.GpuUsageText, Mode=OneWay}"
                                    controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GpuReadingCard}" Padding="12,8" MinHeight="44">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <controls:WidgetIcon IconName="voltage" Width="24" Height="24" />
                                    <TextBlock Text="Core voltage" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" Style="{StaticResource DiagnosticReading}"
                                    controls:MetricText.Value="{x:Bind Model.CoreVoltageText, Mode=OneWay}"
                                    controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GpuReadingCard}">
                            <Grid ColumnDefinitions="126,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <controls:WidgetIcon IconName="vcore" Width="24" Height="24" />
                                    <TextBlock Text="Clocks" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                    <ContentControl Content="{x:Bind Model.CoreClock}" ContentTemplate="{StaticResource GpuReading}"
                                        HorizontalContentAlignment="Stretch" />
                                    <Border Grid.Column="1" Style="{StaticResource GpuReadingDivider}">
                                        <ContentControl Content="{x:Bind Model.MemoryClock}" ContentTemplate="{StaticResource GpuReading}"
                                            HorizontalContentAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GpuReadingCard}">
                            <Grid ColumnDefinitions="126,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <controls:WidgetIcon IconName="vramusage" Width="24" Height="24" />
                                    <TextBlock Text="VRAM usage" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,9*" RowSpacing="5">
                                    <Viewbox Grid.ColumnSpan="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                        <TextBlock controls:MetricText.Value="{x:Bind Model.VramUsage.Value, Mode=OneWay}" Style="{StaticResource DiagnosticReading}"
                                            controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" FontSize="18"
                                            ToolTipService.ToolTip="{x:Bind Model.VramUsage.Value, Mode=OneWay}" />
                                    </Viewbox>
                                    <ProgressBar x:Name="VramUsageBar" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="{x:Bind Model.VramUsagePercent, Mode=OneWay}" Foreground="{ThemeResource MonitorAccent}"
                                        Background="{ThemeResource MonitorTrack}" AutomationProperties.AccessibilityView="Raw"
                                        Visibility="{x:Bind Model.HasVramUsage, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GpuReadingCard}">
                            <Grid ColumnDefinitions="126,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <controls:WidgetIcon IconName="vtemp" Width="24" Height="24" />
                                    <TextBlock Text="Temperatures" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <Grid ColumnDefinitions="*,*">
                                        <ContentControl Content="{x:Bind Model.CoreTemperature}" ContentTemplate="{StaticResource GpuReading}"
                                            HorizontalContentAlignment="Stretch" />
                                        <Border Grid.Column="1" Style="{StaticResource GpuReadingDivider}">
                                            <ContentControl Content="{x:Bind Model.MemoryTemperature}" ContentTemplate="{StaticResource GpuReading}"
                                                HorizontalContentAlignment="Stretch" />
                                        </Border>
                                    </Grid>
                                    <ContentControl x:Name="HotspotReading" x:Load="{x:Bind Model.HasHotspotTemperature, Mode=OneWay}"
                                        Content="{x:Bind Model.HotspotTemperature}" ContentTemplate="{StaticResource GpuReading}"
                                        HorizontalContentAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GpuReadingCard}">
                            <Grid ColumnDefinitions="126,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <controls:WidgetIcon IconName="vfan" Width="24" Height="24" />
                                    <TextBlock Text="Fans" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                    <ContentControl Content="{x:Bind Model.Fan1}" ContentTemplate="{StaticResource GpuReading}"
                                        HorizontalContentAlignment="Stretch" />
                                    <Border x:Name="SecondFanReading" x:Load="{x:Bind Model.HasSecondFan, Mode=OneWay}"
                                        Grid.Column="1" Style="{StaticResource GpuReadingDivider}">
                                        <ContentControl Content="{x:Bind Model.Fan2}" ContentTemplate="{StaticResource GpuReading}"
                                            HorizontalContentAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="AdditionalReadings" x:Load="{x:Bind HasAdditionalMetrics}" BorderBrush="{ThemeResource MonitorBorder}"
                            BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <ItemsControl ItemsSource="{x:Bind AdditionalMetrics}" ItemTemplate="{StaticResource CompactMetric}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PowerStatusFrame" x:Load="{x:Bind ShowSummary}" Grid.Column="1"
                Style="{StaticResource MonitorCard}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <controls:WidgetIcon IconName="power" Width="28" Height="28" />
                        <TextBlock Text="GPU Power Status" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Border Style="{StaticResource GpuReadingCard}" Padding="12,8,12,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:WidgetIcon IconName="boost-limit" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Text="Active boost limits" Style="{StaticResource GpuReadingCaption}" VerticalAlignment="Center" />
                                    <Button Padding="5" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Show boost-limit durations" AutomationProperties.Name="Show boost-limit durations">
                                        <Image Width="18" Height="18">
                                            <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/info-action.svg" /></Image.Source>
                                        </Image>
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom" Opening="BoostLimitsFlyout_Opening">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="MinWidth" Value="0" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Border Style="{StaticResource MonitorCard}" Padding="0">
                                                    <StackPanel>
                                                        <Grid ColumnDefinitions="*,90" ColumnSpacing="12" Padding="12,8"
                                                            BorderBrush="{ThemeResource MonitorBorder}" BorderThickness="0,0,0,1">
                                                            <TextBlock Text="Boost limit" Style="{StaticResource MonitorCaption}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="Time limited" Style="{StaticResource MonitorCaption}"
                                                                FontWeight="SemiBold" TextAlignment="Right" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Bind Model.Diagnostics.BoostLimits}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="telemetry:MetricViewModel">
                                                                    <Grid ColumnDefinitions="*,90" ColumnSpacing="12" Padding="12,6">
                                                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Foreground="{ThemeResource MonitorForeground}" />
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}"
                                                                            Foreground="{ThemeResource MonitorForeground}" FontWeight="SemiBold" TextAlignment="Right" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource MonitorDanger}" VerticalAlignment="Center"
                                        Visibility="{x:Bind Model.Diagnostics.ActiveBoostLimits.IsWarning, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.Name="Hardware or thermal limit active" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Model.Diagnostics.ActiveBoostLimits.Value, Mode=OneWay}"
                                        Style="{StaticResource DiagnosticReading}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4" Padding="4,6,4,8">
                            <TextBlock Text="GPU power limit range" Style="{StaticResource MonitorSectionHeading}" />
                            <Grid Height="22" Visibility="{x:Bind Model.Diagnostics.HasPowerScale, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                                <Border Height="3" Margin="5,0" VerticalAlignment="Center"
                                    Background="{ThemeResource MonitorTrack}" CornerRadius="2" />
                                <Canvas x:Name="PowerScale" SizeChanged="PowerScale_SizeChanged" AutomationProperties.AccessibilityView="Raw">
                                    <Rectangle x:Name="EnforcedPowerMarker" Canvas.Top="2" Width="4" Height="10" RadiusX="2" RadiusY="2"
                                        Fill="{ThemeResource MonitorAccent}" Visibility="Collapsed" />
                                    <Ellipse x:Name="DefaultPowerMarker" Canvas.Top="11" Width="8" Height="8"
                                        Stroke="{ThemeResource MonitorMuted}" StrokeThickness="2" Visibility="Collapsed" />
                                </Canvas>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBlock Text="{x:Bind Model.Diagnostics.MinimumPowerText, Mode=OneWay}" Style="{StaticResource MonitorCaption}"
                                    AutomationProperties.Name="Minimum power limit" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Model.Diagnostics.MaximumPowerText, Mode=OneWay}" Style="{StaticResource MonitorCaption}"
                                    TextAlignment="Right" AutomationProperties.Name="Maximum power limit" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource MonitorAccent}" VerticalAlignment="Center" />
                                        <TextBlock Text="Enforced limit" Style="{StaticResource MonitorCaption}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Model.Diagnostics.EnforcedPower.Value, Mode=OneWay}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Stroke="{ThemeResource MonitorMuted}" StrokeThickness="2" VerticalAlignment="Center" />
                                        <TextBlock Text="Default limit" Style="{StaticResource MonitorCaption}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Model.Diagnostics.DefaultPower.Value, Mode=OneWay}" FontWeight="SemiBold" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel BorderBrush="{ThemeResource MonitorBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <ContentControl Content="{x:Bind Model.Diagnostics.CurrentPState}" ContentTemplate="{StaticResource CompactMetric}" HorizontalContentAlignment="Stretch" />
                            <ContentControl Content="{x:Bind Model.Diagnostics.SupportedPStates}" ContentTemplate="{StaticResource CompactMetric}" HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PcieStatusFrame" x:Load="{x:Bind ShowSummary}" Grid.Column="2"
                Style="{StaticResource MonitorCard}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <controls:WidgetIcon IconName="pcie-link" Width="28" Height="28" />
                        <TextBlock Text="GPU PCIe Status" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource GpuReadingCard}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:WidgetIcon IconName="pcie-link" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Model.Diagnostics.CurrentLink.Label}" Style="{StaticResource GpuReadingCaption}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock controls:MetricText.Value="{x:Bind Model.Diagnostics.CurrentLink.Value, Mode=OneWay}" Style="{StaticResource DiagnosticReading}"
                                controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Model.Diagnostics.CurrentLink.Value, Mode=OneWay}" />
                            <Border Height="1" Background="{ThemeResource MonitorBorder}" AutomationProperties.AccessibilityView="Raw" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{x:Bind Model.Diagnostics.MaximumLink.Label}" Style="{StaticResource GpuReadingCaption}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" controls:MetricText.Value="{x:Bind Model.Diagnostics.MaximumLink.Value, Mode=OneWay}"
                                    controls:MetricText.UnitForeground="{ThemeResource MonitorMuted}" Style="{StaticResource DiagnosticReading}" FontSize="16"
                                    TextTrimming="CharacterEllipsis" MaxWidth="225" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind Model.Diagnostics.MaximumLink.Value, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{x:Bind Model.Diagnostics.MaximumGpuGeneration.Label}" Style="{StaticResource GpuReadingCaption}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Model.Diagnostics.MaximumGpuGeneration.Value, Mode=OneWay}"
                                    Style="{StaticResource DiagnosticReading}" FontSize="14" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource GpuReadingCard}">
                            <ContentControl Content="{x:Bind Model.Diagnostics.ReceiveThroughput}" ContentTemplate="{StaticResource TrafficReading}"
                                HorizontalContentAlignment="Stretch" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource GpuReadingCard}">
                            <ContentControl Content="{x:Bind Model.Diagnostics.TransmitThroughput}" ContentTemplate="{StaticResource TrafficReading}"
                                HorizontalContentAlignment="Stretch" />
                        </Border>
                    </Grid>

                    <StackPanel BorderBrush="{ThemeResource MonitorBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <ContentControl Content="{x:Bind Model.Diagnostics.Replays}" ContentTemplate="{StaticResource CompactMetric}" HorizontalContentAlignment="Stretch" />
                        <ContentControl Content="{x:Bind Model.Diagnostics.ReplayRollovers}" ContentTemplate="{StaticResource CompactMetric}" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
