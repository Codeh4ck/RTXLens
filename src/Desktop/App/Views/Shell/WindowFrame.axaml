<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="RTXLens.App.Views.Shell.WindowFrame">
    <UserControl.Resources>
        <ControlTheme x:Key="CaptionButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover, ^:focus-visible">
                <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            </Style>
            <Style Selector="^.close-button:pointerover, ^.close-button:focus-visible">
                <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Border x:Name="FrameBorder" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="34,*">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                            <PathIcon Data="M1 8H4V15H1ZM6 5H9V15H6ZM11 1H14V15H11Z"
                                      Width="14" Height="14" Foreground="{DynamicResource IconBrush}" />
                            <TextBlock x:Name="CaptionTitle" Classes="caption" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Theme="{StaticResource CaptionButtonTheme}" Click="MinimizeWindow"
                                AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize"
                                chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
                            <PathIcon Width="11" Height="11" Data="M0 6H11V7H0Z" />
                        </Button>
                        <Button x:Name="MaximizeButton" Theme="{StaticResource CaptionButtonTheme}" Click="ToggleMaximize"
                                AutomationProperties.Name="Maximize" ToolTip.Tip="Maximize"
                                chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
                            <Panel>
                                <PathIcon x:Name="MaximizeIcon" Width="11" Height="11"
                                          Data="F0 M0 0H11V11H0Z M1 1H10V10H1Z" />
                                <PathIcon x:Name="RestoreIcon" Width="11" Height="11" IsVisible="False"
                                          Data="F0 M0 3H8V11H0Z M1 4H7V10H1Z M3 0H11V8H9V7H10V1H4V2H3Z" />
                            </Panel>
                        </Button>
                        <Button Theme="{StaticResource CaptionButtonTheme}" Classes="close-button" Click="CloseWindow"
                                AutomationProperties.Name="Close window" ToolTip.Tip="Close"
                                chrome:WindowDecorationProperties.ElementRole="CloseButton">
                            <PathIcon Width="11" Height="11"
                                      Data="M0 1L1 0L5.5 4.5L10 0L11 1L6.5 5.5L11 10L10 11L5.5 6.5L1 11L0 10L4.5 5.5Z" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="BodyHost" Grid.Row="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
