<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RTXLens.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <x:Double x:Key="DesktopFontSize">14</x:Double>
            <x:Double x:Key="DesktopHeadingFontSize">24</x:Double>
            <x:Double x:Key="DesktopCaptionFontSize">12</x:Double>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Palette.axaml" />
                <ResourceInclude Source="/Themes/FluentControlPalette.axaml" />
                <ResourceInclude Source="/Themes/ControlThemes.axaml" />
                <ResourceInclude Source="/Themes/EditableList.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Themes/ControlStyles.axaml" />
    </Application.Styles>
</Application>