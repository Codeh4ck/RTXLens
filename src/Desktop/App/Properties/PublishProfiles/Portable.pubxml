<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishDir Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)/../../../artifacts/desktop/win-x64/</PublishDir>
        <PublishDir Condition="'$(Configuration)' != 'Release'">$(MSBuildProjectDirectory)/../../../artifacts/desktop-debug/win-x64/</PublishDir>
    </PropertyGroup>
</Project>
